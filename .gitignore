# .gitignore

# Build output
dist/
.build-binary/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
build/

# Virtualenvs (the pip cache IS committed; the venv itself is NOT)
venv/
.venv/
env/

# State directories created at deploy time — never commit these
.platform-installer-state/

# private_data_dir (generated vars/inventory + synced playbooks, used by
# ansible-runner's container executor) lives under .platform-installer-state/,
# already ignored below — nothing generated directly under ansible/ anymore.

# Secrets — should never be committed
*.key
pull-secret.json
vault-init-keys.json*
*.enc

# Actual config files — examples are committed; real configs are not
platform-config.yaml
platform-manifest.yaml
# (platform-config.yaml.example and platform-manifest.yaml.example ARE committed)

# Collections lock is committed (written by stage_collections.sh)
# collections/ tarballs are NOT committed (too large; use Artifactory)
collections/*.tar.gz

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
reports/
*.coverage
htmlcov/
