#!/usr/bin/env bash
# platform-installer
#
# Host wrapper script for the platform-installer container image.
#
# This script is self-contained: if the container image is not loaded in the
# local store, it locates the image tarball (expected alongside this script),
# verifies its checksum, loads it, then runs the requested command.
#
# The operator runs this script exactly as they would run the native CLI.
# The container is completely transparent.
#
# Setup (one time):
#   1. Transfer both files to the admin server into the same directory:
#        platform-installer-@@VERSION@@-container.tar.gz
#        platform-installer-@@VERSION@@-container.tar.gz.sha256
#        platform-installer          (this script)
#        installer.env.example
#   2. chmod +x platform-installer
#   3. Copy installer.env.example → installer.env and fill in your paths
#   4. Export Vault credentials:
#        export VAULT_ROLE_ID=<role-id>
#        export VAULT_SECRET_ID=<secret-id>
#
# Usage (identical to the native platform-installer CLI):
#   ./platform-installer deploy
#   ./platform-installer deploy --phase preflight
#   ./platform-installer deploy --from-phase hub_cluster --dry-run
#   ./platform-installer status
#   ./platform-installer reset --phase management_services
#   ./platform-installer validate
#   ./platform-installer stage-collections
#   ./platform-installer report
#   ./platform-installer --help
#
# Built-in image management:
#   If the image is not loaded, this script finds the tarball in the same
#   directory, verifies its SHA-256 checksum, and loads it automatically.
#   No manual 'podman load' step required.
#
# Version: @@VERSION@@

set -euo pipefail

# ── Script identity ────────────────────────────────────────────────────────────
# SCRIPT_DIR is the directory containing this wrapper script.
# The image tarball is expected to live in the same directory.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Stamped at build time by build_image.sh
IMAGE_NAME="@@IMAGE_NAME@@"
IMAGE_VERSION="@@VERSION@@"
IMAGE_TAG="${IMAGE_NAME}:${IMAGE_VERSION}"
CONTAINER_TARBALL="${SCRIPT_DIR}/${IMAGE_NAME}-${IMAGE_VERSION}-container.tar.gz"
CONTAINER_TARBALL_CHECKSUM="${CONTAINER_TARBALL}.sha256"

# ── Colour output helpers ──────────────────────────────────────────────────────
# Only use colour when stdout is a terminal
if [[ -t 1 ]]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
  CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; CYAN=''; BOLD=''; RESET=''
fi

info()    { echo -e "${CYAN}==>${RESET} $*"; }
success() { echo -e "    ${GREEN}✔${RESET}  $*"; }
warn()    { echo -e "    ${YELLOW}⚠${RESET}  $*"; }
die()     { echo -e "${RED}ERROR:${RESET} $*" >&2; exit 1; }
banner()  { echo -e "\n${BOLD}${*}${RESET}"; }

# ── Load installer.env ─────────────────────────────────────────────────────────
ENV_FILE="${SCRIPT_DIR}/installer.env"
if [[ ! -f "${ENV_FILE}" ]]; then
  die "installer.env not found.

  Create it from the example:
    cp ${SCRIPT_DIR}/installer.env.example ${SCRIPT_DIR}/installer.env
    \$EDITOR ${SCRIPT_DIR}/installer.env"
fi
# shellcheck source=/dev/null
source "${ENV_FILE}"

# ── Validate required installer.env variables ──────────────────────────────────
MISSING_VARS=()
[[ -z "${CONFIG_DIR:-}"       ]] && MISSING_VARS+=("CONFIG_DIR")
[[ -z "${STATE_DIR:-}"        ]] && MISSING_VARS+=("STATE_DIR")
[[ -z "${SSH_PUBLIC_KEY:-}"   ]] && MISSING_VARS+=("SSH_PUBLIC_KEY")
[[ -z "${SSH_PRIVATE_KEY:-}"  ]] && MISSING_VARS+=("SSH_PRIVATE_KEY")
[[ -z "${INTERNAL_CA_CERT:-}" ]] && MISSING_VARS+=("INTERNAL_CA_CERT")
[[ -z "${INTERNAL_CA_KEY:-}"  ]] && MISSING_VARS+=("INTERNAL_CA_KEY")
[[ -z "${PULL_SECRET:-}"      ]] && MISSING_VARS+=("PULL_SECRET")
[[ -z "${ASSETS_DIR:-}"       ]] && MISSING_VARS+=("ASSETS_DIR")

if [[ ${#MISSING_VARS[@]} -gt 0 ]]; then
  die "Required variables not set in installer.env:
$(printf '  - %s\n' "${MISSING_VARS[@]}")

  Edit ${ENV_FILE} to set them."
fi

# ── Validate required files exist ─────────────────────────────────────────────
MISSING_FILES=()
[[ -f "${CONFIG_DIR}/platform-config.yaml"   ]] || MISSING_FILES+=("${CONFIG_DIR}/platform-config.yaml")
[[ -f "${CONFIG_DIR}/platform-manifest.yaml" ]] || MISSING_FILES+=("${CONFIG_DIR}/platform-manifest.yaml")
[[ -f "${SSH_PRIVATE_KEY}"                   ]] || MISSING_FILES+=("${SSH_PRIVATE_KEY}")
[[ -f "${SSH_PUBLIC_KEY}"                    ]] || MISSING_FILES+=("${SSH_PUBLIC_KEY}")
[[ -f "${INTERNAL_CA_CERT}"                  ]] || MISSING_FILES+=("${INTERNAL_CA_CERT}")
[[ -f "${INTERNAL_CA_KEY}"                   ]] || MISSING_FILES+=("${INTERNAL_CA_KEY}")
[[ -f "${PULL_SECRET}"                       ]] || MISSING_FILES+=("${PULL_SECRET}")

if [[ ${#MISSING_FILES[@]} -gt 0 ]]; then
  die "Required files not found:
$(printf '  - %s\n' "${MISSING_FILES[@]}")

  Ensure all paths in installer.env point to existing files."
fi

# ── Validate Vault credentials ─────────────────────────────────────────────────
if [[ -z "${VAULT_ROLE_ID:-}" ]] || [[ -z "${VAULT_SECRET_ID:-}" ]]; then
  die "Vault credentials not set.

  Export before running:
    export VAULT_ROLE_ID=<role-id>
    export VAULT_SECRET_ID=<secret-id>"
fi

# ── Detect container runtime ───────────────────────────────────────────────────
_detect_runtime() {
  local runtime="${CONTAINER_RUNTIME:-}"
  if [[ -n "${runtime}" ]]; then
    command -v "${runtime}" &>/dev/null \
      || die "CONTAINER_RUNTIME=${runtime} set in installer.env but '${runtime}' not found on PATH"
    echo "${runtime}"
    return
  fi
  if command -v podman &>/dev/null; then
    echo "podman"
  elif command -v docker &>/dev/null; then
    echo "docker"
  else
    die "Neither podman nor docker found on PATH.
  Install podman: dnf install -y podman"
  fi
}

RUNTIME="$(_detect_runtime)"

# ── Image load (auto) ──────────────────────────────────────────────────────────
# Check if the image is already in the local store.
# If not, find the tarball in SCRIPT_DIR, verify checksum, and load it.
_ensure_image_loaded() {
  # Fast path: image already available
  if ${RUNTIME} image inspect "${IMAGE_TAG}" &>/dev/null 2>&1; then
    return 0
  fi

  banner "Image not found locally — loading ${IMAGE_TAG}"

  # ── Locate the tarball ───────────────────────────────────────────────────────
  if [[ ! -f "${CONTAINER_TARBALL}" ]]; then
    # Try a glob in case the exact version filename differs slightly
    local found
    found="$(ls "${SCRIPT_DIR}/${IMAGE_NAME}-"*"-container.tar.gz" 2>/dev/null | head -1)"
    if [[ -n "${found}" ]]; then
      warn "Expected tarball not found at:"
      warn "  ${CONTAINER_TARBALL}"
      warn "Using: ${found}"
      CONTAINER_TARBALL="${found}"
      CONTAINER_TARBALL_CHECKSUM="${found}.sha256"
    else
      die "Image tarball not found.

  Expected: ${CONTAINER_TARBALL}

  Ensure the container tarball is in the same directory as this script:
    ls ${SCRIPT_DIR}/${IMAGE_NAME}-*-container.tar.gz"
    fi
  fi

  info "Tarball: ${CONTAINER_TARBALL}"

  # ── Verify checksum ──────────────────────────────────────────────────────────
  if [[ -f "${CONTAINER_TARBALL_CHECKSUM}" ]]; then
    info "Verifying SHA-256 checksum ..."
    if sha256sum --check "${CONTAINER_TARBALL_CHECKSUM}" --quiet 2>/dev/null; then
      success "Checksum verified"
    else
      die "Checksum verification FAILED.

  The tarball may be corrupt or incomplete.
  Re-transfer and try again:
    ${CONTAINER_TARBALL}"
    fi
  else
    warn "No .sha256 file found — skipping checksum verification"
    warn "Expected: ${CONTAINER_TARBALL_CHECKSUM}"
  fi

  # ── Load the image ───────────────────────────────────────────────────────────
  info "Loading image with ${RUNTIME} (this may take a minute) ..."
  if ! ${RUNTIME} load < "${CONTAINER_TARBALL}"; then
    die "${RUNTIME} load failed.
  Check available disk space and try again."
  fi

  # ── Confirm the image is now available ───────────────────────────────────────
  if ! ${RUNTIME} image inspect "${IMAGE_TAG}" &>/dev/null 2>&1; then
    # The tarball may have been saved under a different tag — try to retag
    local loaded_id
    loaded_id="$(${RUNTIME} images --format '{{.ID}}' --filter dangling=false \
                   | head -1 2>/dev/null || true)"
    if [[ -n "${loaded_id}" ]]; then
      warn "Image loaded but tag '${IMAGE_TAG}' not found — retagging ..."
      ${RUNTIME} tag "${loaded_id}" "${IMAGE_TAG}" \
        || die "Could not retag loaded image to ${IMAGE_TAG}"
    else
      die "Image failed to load or is not visible after 'load'.
  Run manually to diagnose:
    ${RUNTIME} load < ${CONTAINER_TARBALL}
    ${RUNTIME} images"
    fi
  fi

  # ── Quick smoke test ─────────────────────────────────────────────────────────
  info "Running smoke test ..."
  if ${RUNTIME} run --rm "${IMAGE_TAG}" --help > /dev/null 2>&1; then
    success "Image loaded and functional: ${IMAGE_TAG}"
  else
    die "Image loaded but smoke test failed.
  The image may be corrupt. Rebuild and transfer again."
  fi
}

_ensure_image_loaded

# ── SSH key permissions check ──────────────────────────────────────────────────
_ssh_perms="$(stat -c '%a' "${SSH_PRIVATE_KEY}" 2>/dev/null \
              || stat -f '%A' "${SSH_PRIVATE_KEY}" 2>/dev/null \
              || echo 'unknown')"
if [[ "${_ssh_perms}" != "600" && "${_ssh_perms}" != "400" ]]; then
  warn "SSH private key permissions are ${_ssh_perms} (should be 600 or 400)"
  warn "Fix with: chmod 600 ${SSH_PRIVATE_KEY}"
fi

# ── State directory ────────────────────────────────────────────────────────────
mkdir -p "${STATE_DIR}"

# ── Volume mounts ──────────────────────────────────────────────────────────────
# Every mount is explicit and documented.
# :ro  = read-only (installer reads but never writes)
# :rw  = read-write (state must persist across runs)
# :z   = SELinux relabel (required on RHEL 9 with enforcing SELinux)
VOLUMES=(
  # Config — read-only; operator writes, installer reads
  "-v" "${CONFIG_DIR}/platform-config.yaml:/workspace/config/platform-config.yaml:ro,z"
  "-v" "${CONFIG_DIR}/platform-manifest.yaml:/workspace/config/platform-manifest.yaml:ro,z"

  # State — read-write; must survive container restarts and image upgrades
  "-v" "${STATE_DIR}:/workspace/state:rw,z"

  # SSH keys — read-only; installer uses these to reach managed hosts
  "-v" "${SSH_PRIVATE_KEY}:/workspace/ssh/installer_rsa:ro,z"
  "-v" "${SSH_PUBLIC_KEY}:/workspace/ssh/installer_rsa.pub:ro,z"

  # PKI — read-only; CA cert distributed to nodes, CA key signs service certs
  "-v" "${INTERNAL_CA_CERT}:/workspace/pki/internal-ca.crt:ro,z"
  "-v" "${INTERNAL_CA_KEY}:/workspace/pki/internal-ca.key:ro,z"

  # Pull secret — read-only
  "-v" "${PULL_SECRET}:/workspace/pull-secret.json:ro,z"

  # Staged assets — read-only; large files stay on host, never copied into container
  "-v" "${ASSETS_DIR}:/workspace/assets:ro,z"
)

# Optional: ssh known_hosts forwarding
if [[ -f "${HOME}/.ssh/known_hosts" ]]; then
  VOLUMES+=("-v" "${HOME}/.ssh/known_hosts:/root/.ssh/known_hosts:ro,z")
fi

# Optional: extra mounts declared in installer.env as space-separated host:container pairs
if [[ -n "${EXTRA_VOLUMES:-}" ]]; then
  for vol in ${EXTRA_VOLUMES}; do
    VOLUMES+=("-v" "${vol}")
  done
fi

# ── Environment variables ──────────────────────────────────────────────────────
ENV_VARS=(
  # Vault credentials — passed as env vars, never written to disk in container
  "-e" "VAULT_ROLE_ID=${VAULT_ROLE_ID}"
  "-e" "VAULT_SECRET_ID=${VAULT_SECRET_ID}"

  # Override paths inside the container to use mounted workspace locations
  "-e" "PLATFORM_STATE_DIR=/workspace/state"
  "-e" "PLATFORM_WORKSPACE=/workspace"
)

# Forward proxy settings if configured in installer.env
[[ -n "${HTTP_PROXY:-}"  ]] && ENV_VARS+=("-e" "HTTP_PROXY=${HTTP_PROXY}")
[[ -n "${HTTPS_PROXY:-}" ]] && ENV_VARS+=("-e" "HTTPS_PROXY=${HTTPS_PROXY}")
[[ -n "${NO_PROXY:-}"    ]] && ENV_VARS+=("-e" "NO_PROXY=${NO_PROXY}")

# ── Translate host paths in CLI args to container paths ────────────────────────
# Operator can pass --config /home/ops/platform-config.yaml and the wrapper
# silently maps it to the container equivalent. All other args pass through.
_translate_path() {
  local p="${1}"
  p="${p/${CONFIG_DIR}//workspace/config}"
  p="${p/${STATE_DIR}//workspace/state}"
  p="${p/${ASSETS_DIR}//workspace/assets}"
  echo "${p}"
}

TRANSLATED_ARGS=()
SKIP_NEXT=false
for arg in "$@"; do
  if [[ "${SKIP_NEXT}" == "true" ]]; then
    TRANSLATED_ARGS+=("$(_translate_path "${arg}")")
    SKIP_NEXT=false
    continue
  fi
  case "${arg}" in
    --config|-c|--manifest|-m|--state-dir|--collections-dir)
      TRANSLATED_ARGS+=("${arg}")
      SKIP_NEXT=true
      ;;
    *)
      TRANSLATED_ARGS+=("${arg}")
      ;;
  esac
done

# ── Inject default flags if not already supplied ───────────────────────────────
# Saves the operator from having to type --config and --state-dir every time.
_has_flag() {
  local flag="$1"; shift
  for arg in "$@"; do
    [[ "${arg}" == "${flag}" ]] && return 0
  done
  return 1
}

INJECTED_ARGS=()
_has_flag "--config"    "$@" || _has_flag "-c" "$@" || \
  INJECTED_ARGS+=("--config" "/workspace/config/platform-config.yaml")

_has_flag "--manifest"  "$@" || _has_flag "-m" "$@" || \
  INJECTED_ARGS+=("--manifest" "/workspace/config/platform-manifest.yaml")

_has_flag "--state-dir" "$@" || \
  INJECTED_ARGS+=("--state-dir" "/workspace/state")

# ── Execute ────────────────────────────────────────────────────────────────────
# --rm          remove container when it exits (state is on the mounted volume)
# --interactive pass stdin through (needed for confirmation prompts)
# --tty         attach a TTY (needed for Rich console colour output)
# --network host installer connects directly to BMC IPs, vCenter, Vault, etc.
exec "${RUNTIME}" run \
  --rm \
  --interactive \
  --tty \
  --network host \
  "${VOLUMES[@]}" \
  "${ENV_VARS[@]}" \
  ${EXTRA_RUN_FLAGS:-} \
  "${IMAGE_TAG}" \
  "${INJECTED_ARGS[@]}" \
  "${TRANSLATED_ARGS[@]}"
